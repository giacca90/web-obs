{
  "name": "web-obs",
  "version": "0.0.18",
  "license": "MIT",
  "private": false,
  "description": "Web-OBS es una librería de Angular 20 y un WebComponent que permite crear broadcasts de video y audio directamente ne el navegador.",
  "keywords": [
    "angular",
    "web-obs",
    "obs",
    "video",
    "audio",
    "broadcast",
    "live-streaming",
    "streaming",
    "web-component"
  ],
  "author": {
    "name": "Giacca90",
    "email": "giacca90mobile@protonmail.com"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/giacca90/web-obs.git"
  },
  "scripts": {
    "ng": "ng",
    "start": "ng serve demo-app",
    "tailwind:build": "npx tailwindcss -i ./projects/web-obs/src/styles/tailwind.css -o ./projects/web-obs/src/lib/editor-webcam/assets/tailwind.generated.css --config ./tailwind.config.js --minify",
    "tailwind:watch": "npx tailwindcss -i ./projects/web-obs/src/styles/tailwind.css -o ./projects/web-obs/src/lib/editor-webcam/assets/tailwind.generated.css --config ./tailwind.config.js --watch",
    "build:workers": "tsc -p tsconfig.workers.json && node generate-workers.mjs",
    "build:lib": "npm run tailwind:build && npm run build:workers && ng build web-obs && cp ./docs/README_Angular.md ./dist/web-obs/README.md && cd dist/web-obs && npm pack",
    "build:lib:watch": "npm run build:workers && ng build web-obs --watch",
    "build:elements": "npm run build:workers && ng run web-obs:elements && node generate-package.js && cp ./docs/README_WebComponent.md ./dist/web-obs/elements/README.md && cd dist/web-obs/elements && npm pack",
    "build": "npm run build:lib && npm run build:elements && npm run license-report",
    "start:elements": "ng serve web-obs:serve-elements",
    "start:demo": "ng serve demo-app",
    "dev": "clear && concurrently \"npm run tailwind:watch\" \"npm run build:lib:watch\" \"npm run start:demo\"",
    "test": "ng test web-obs",
    "test:ci": "export CHROME_BIN=/usr/bin/chromium && ng test web-obs --browsers=ChromeHeadless --no-watch --no-progress",
    "test:cov": "export CHROME_BIN=/usr/bin/chromium && ng test web-obs --browsers=ChromeHeadless --no-watch --no-progress --code-coverage",
    "lint": "ng lint",
    "clean": "rimraf dist out-tsc",
    "publish:demo": "npm run build && npm run build:elements && node publish-visits.js && gh-pages -d dist/web-obs/elements",
    "publish:web-obs": "cd dist/web-obs && npm publish --access public",
    "publish:elements": "cd dist/web-obs/elements && npm publish --access public",
    "publish": "npm run build && npm run publish:web-obs && npm run publish:elements && node publish-visits.js && gh-pages -d dist/web-obs/elements",
    "release:patch": "npm version patch && cd projects/web-obs && npm version patch && cd ../.. && npm run publish",
    "release:minor": "npm version minor && cd projects/web-obs && npm version minor && cd ../.. && npm run publish",
    "release:major": "npm version major && cd projects/web-obs && npm version major && cd ../.. && npm run publish",
    "license-report": "license-checker --txt --out THIRD-PARTY-LICENSES.txt && sed -i \"s|$PWD|.|g\" THIRD-PARTY-LICENSES.txt"
  },
  "prettier": {
    "overrides": [
      {
        "files": "*.html",
        "options": {
          "parser": "angular"
        }
      }
    ]
  },
  "dependencies": {
    "tslib": "^2.8.1"
  },
  "peerDependencies": {
    "@angular/common": "^22.1.1",
    "@angular/compiler": "^22.1.1",
    "@angular/core": "^22.1.1",
    "@angular/elements": "^22.1.1",
    "@angular/forms": "^22.1.1",
    "@angular/platform-browser": "^22.1.1",
    "@angular/router": "^22.1.1",
    "rxjs": "~7.8.2",
    "zone.js": "^0.16.2"
  },
  "devDependencies": {
    "@angular-devkit/build-angular": "^22.1.3",
    "@angular/build": "^22.1.3",
    "@angular/cli": "^22.1.3",
    "@angular/common": "^22.1.1",
    "@angular/compiler": "^22.1.1",
    "@angular/compiler-cli": "^22.1.1",
    "@angular/core": "^22.1.1",
    "@angular/elements": "^22.1.1",
    "@angular/forms": "^22.1.1",
    "@angular/platform-browser": "^22.1.1",
    "@angular/platform-browser-dynamic": "^22.1.1",
    "@tailwindcss/cli": "^4.3.3",
    "@tailwindcss/postcss": "^4.1.12",
    "@types/jasmine": "~6.0.0",
    "autoprefixer": "^10.5.4",
    "concurrently": "^10.0.4",
    "gh-pages": "^6.3.0",
    "jasmine-core": "~7.0.2",
    "karma": "~6.4.4",
    "karma-chrome-launcher": "~3.2.0",
    "karma-coverage": "~2.2.1",
    "karma-coverage-istanbul-reporter": "^3.0.3",
    "karma-firefox-launcher": "^2.1.3",
    "karma-jasmine": "~5.1.0",
    "karma-jasmine-html-reporter": "~2.3.0",
    "license-checker": "^25.0.1",
    "ng-packagr": "^22.1.1",
    "ngx-build-plus": "^20.0.0",
    "postcss": "^8.5.26",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "tailwind-scrollbar": "^4.0.2",
    "typescript": "6.0.3",
    "undici-types": "^8.10.0",
    "zone.js": "^0.16.2"
  },
  "allowScripts": {
    "@parcel/watcher@2.6.0": true,
    "@parcel/watcher@2.5.1": true,
    "esbuild@0.28.2": true,
    "lmdb@3.5.6": true,
    "msgpackr-extract@3.0.4": true
  }
}
